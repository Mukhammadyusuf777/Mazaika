generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  email       String?  @unique
  phone       String?  @unique
  name        String
  password    String?
  googleId    String?  @unique
  firebaseUid String?  @unique
  bots        Bot[]
  sites       Site[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Bot {
  id          String     @id @default(uuid())
  name        String
  token       String?    @unique
  status      String     @default("active")
  projectType String     @default("bot")
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflows   Workflow[]
  contacts    Contact[]
  webhooks    Webhook[]
  site        Site?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Site {
  id            String   @id @default(uuid())
  botId         String?  @unique
  bot           Bot?     @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug          String   @unique
  appName       String
  theme         String   @default("glassmorphism")
  themeColor    String   @default("#00D9FF")
  sourceCode    String   // Full combined index.html
  files         String   // JSON stringified VFS files ({ 'index.html': ..., 'style.css': ... })
  blocks        String?  // JSON stringified blocks
  isPublished   Boolean  @default(true)
  cloudflareUrl String?
  views         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Workflow {
  id          String   @id @default(uuid())
  name        String
  description String?
  isMain      Boolean  @default(false)
  nodes       String   // Stringified JSON for SQLite compatibility
  edges       String   // Stringified JSON for SQLite compatibility
  botId       String
  bot         Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Contact {
  id           String    @id @default(uuid())
  telegramId   String
  firstName    String?
  lastName     String?
  username     String?
  languageCode String?
  state        String?   // Stringified JSON for SQLite compatibility
  botId        String
  bot          Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  messages     Message[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([botId, telegramId])
}

model Message {
  id        String   @id @default(uuid())
  text      String?
  direction String
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Webhook {
  id        String   @id @default(uuid())
  name      String
  url       String
  method    String   @default("POST")
  active    Boolean  @default(true)
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CloudData {
  id         String   @id @default(uuid())
  appId      String
  collection String
  key        String   @unique
  data       String   // JSON stringified
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([appId, collection])
}
